{
  "name": "@project/backend",
  "version": "1.0.0",
  "description": "Backend for my_node_project",
  "keywords": ["backend", "nodejs", "express", "mysql"],
  "author": "Arnaud Joly <arnaud.joly24@outlook.com>",
  "main": "index.js",
  "type": "module",
  "engines":{
    "node": ">=22.0.0"
  },
  "imports": {
    "#configs/*": "./configs/*.js",
    "#controllers/*": "./controllers/*.js",
    "#database/*": "./database/*.js",
    "#errors/*": "./errors/*.js",
    "#models/*": "./models/*.js",
    "#middleware/*": "./middleware/*.js",
    "#repositories/*": "./repositories/*.js",
    "#routers/*": "./routers/*.js",
    "#services/*": "./services/*.js",
    "#tests/*": "./tests/*.js",
    "#utils/*": "./utils/*.js",
    "#validators/*": "./validators/*.js"
  },
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "nodemon --env-file=.env --trace-warnings --trace-uncaught index.js",

    "test": "node --env-file=.env --test",
    "test:db": "node --env-file=.env --test ./tests/db.test",
    "test:db:users": "node --env-file=.env --test ./tests/db.test/users.table.test.js",
    
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jolyh/my_node_project.git"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "nodemon": "^3.1.14",
    "uuid": "^14.0.1",
    "@project/shared": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "supertest": "^7.2.2"
  }
}
